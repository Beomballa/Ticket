{
  "title": "Fan Event Platform Overview",
  "uid": "fan-event-overview",
  "schemaVersion": 41,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API p95 latency",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri, method))", "legendFormat": "{{method}} {{uri}}"}],
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API 5xx rate",
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) by (uri)", "legendFormat": "{{uri}}"}],
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cache outcomes",
      "targets": [{"expr": "sum(rate(fan_event_cache_requests_total[5m])) by (result)", "legendFormat": "{{result}}"}],
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Reservation rate limit",
      "targets": [{"expr": "sum(rate(fan_event_reservation_rate_limit_total[5m])) by (result)", "legendFormat": "{{result}}"}],
      "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outbox backlog",
      "targets": [{"expr": "fan_event_outbox_backlog", "legendFormat": "{{status}}"}],
      "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Inventory conflicts and expiration",
      "targets": [
        {"expr": "rate(fan_event_inventory_conflicts_total[5m])", "legendFormat": "inventory conflict"},
        {"expr": "rate(fan_event_reservation_expired_total[5m])", "legendFormat": "expired"}
      ],
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Outbox delivery and manual retry",
      "targets": [
        {"expr": "sum(rate(fan_event_outbox_delivery_total[5m])) by (result)", "legendFormat": "delivery {{result}}"},
        {"expr": "sum(rate(fan_event_outbox_manual_retry_total[5m])) by (result)", "legendFormat": "manual retry {{result}}"}
      ],
      "gridPos": {"x": 0, "y": 24, "w": 24, "h": 8}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Database connection pool",
      "targets": [
        {"expr": "hikaricp_connections_active", "legendFormat": "active {{pool}}"},
        {"expr": "hikaricp_connections_pending", "legendFormat": "pending {{pool}}"},
        {"expr": "increase(hikaricp_connections_timeout_total[5m])", "legendFormat": "timeout increase {{pool}}"}
      ],
      "gridPos": {"x": 0, "y": 32, "w": 24, "h": 8}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Payment authorization claims",
      "targets": [
        {"expr": "sum(rate(fan_event_payment_authorization_claim_total[5m])) by (result)", "legendFormat": "{{result}}"}
      ],
      "gridPos": {"x": 0, "y": 40, "w": 24, "h": 8}
    }
  ]
}
